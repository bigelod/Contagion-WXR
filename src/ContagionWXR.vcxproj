<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{6C1B9A64-2A8E-4F3D-9C1B-7E5D2A0F4B11}</ProjectGuid>
    <RootNamespace>ContagionWXR</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <!-- Output name is version.dll: the proxy has to be named after the DLL it
         replaces. OutDir is anchored to the project file, not $(SolutionDir),
         so the project builds standalone with msbuild. -->
    <TargetName>version</TargetName>
    <OutDir>$(MSBuildThisFileDirectory)..\out\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\out\$(Platform)\$(Configuration)\obj\</IntDir>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <!-- Static CRT: one file to copy into a container that has no
           redistributables. Nothing crosses the DLL boundary, so mixing CRTs
           with the game is not a problem. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_USRDLL;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);$(MSBuildThisFileDirectory)..\third_party\minhook\include;$(MSBuildThisFileDirectory)..\third_party\minhook\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <AdditionalDependencies>psapi.lib;bcrypt.lib;user32.lib;advapi32.lib;ws2_32.lib;d3d9.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="..\third_party\minhook\src\buffer.c" />
    <ClCompile Include="..\third_party\minhook\src\hook.c" />
    <ClCompile Include="..\third_party\minhook\src\trampoline.c" />
    <ClCompile Include="..\third_party\minhook\src\hde\hde32.c" />
    <ClCompile Include="..\third_party\minhook\src\hde\hde64.c" />    <ClCompile Include="buildstamp.cpp" />
    <ClCompile Include="dllmain.cpp" />
    <ClCompile Include="camera.cpp" />
    <ClCompile Include="d3d9hook.cpp" />
    <ClCompile Include="exports.cpp" />
    <ClCompile Include="log.cpp" />
    <ClCompile Include="recon.cpp" />
    <ClCompile Include="xrapi.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="camera.h" />
    <ClInclude Include="d3d9hook.h" />
    <ClInclude Include="log.h" />
    <ClInclude Include="recon.h" />
    <ClInclude Include="xrapi.h" />
  </ItemGroup>
  <ItemGroup>
    <None Include="version.def" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
